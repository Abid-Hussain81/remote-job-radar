# MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/remote-job-radar?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/remote-job-radar?retryWrites=true&w=majority

# Secret bearer token used to authenticate ingestion triggers (e.g. from GitHub Actions cron)
INGEST_SECRET=replace_with_a_secure_random_token

# Simple password for personal access to the radar feed UI
APP_PASSWORD=replace_with_a_secure_password
